---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ApiKeyForm } from '@/components/settings/ApiKeyForm';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
---

<BaseLayout title="Настройки" description="Ключ ИИ-наставника и деплой.">
  <div class="space-y-6">
    <div class="space-y-3">
      <Badge class="border border-primary/40 bg-transparent text-primary uppercase tracking-wider">
        Бесплатно · OpenRouter
      </Badge>
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Настройки</h1>
      <p class="max-w-2xl text-muted-foreground">
        ИИ-наставник на странице кейса вызывает OpenRouter напрямую из браузера. Без ключа кнопка
        «Начать разбор» покажет подсказку — это не поломка модели, а отсутствие ключа или лимитов.
      </p>
    </div>

    <Card class="border-border bg-card/80">
      <CardHeader>
        <CardTitle>Ключ OpenRouter</CardTitle>
        <CardDescription>
          Создай на{" "}
          <a
            class="text-primary underline underline-offset-4"
            href="https://openrouter.ai/keys"
            target="_blank"
            rel="noreferrer"
          >
            openrouter.ai/keys
          </a>
          . По умолчанию используется роутер{" "}
          <code class="rounded bg-muted px-1 py-0.5 text-xs text-accent">openrouter/free</code>.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <ApiKeyForm client:load />
      </CardContent>
    </Card>

    <Card class="border-border bg-card/80">
      <CardHeader>
        <CardTitle>Почему наставник «молчал»</CardTitle>
        <CardDescription>
          До этого релиза UI не вызывал API — были только заглушки модулей. Сейчас на кейсе есть
          реальный чат. Если ошибка 401/429 — проверь ключ и лимиты free-модели.
        </CardDescription>
      </CardHeader>
    </Card>
  </div>
</BaseLayout>
