---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ApiKeyForm } from '@/components/settings/ApiKeyForm';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
---

<BaseLayout title="Настройки" description="Подключи AI-наставника и проверь деплой.">
  <div class="space-y-6">
    <div class="space-y-3">
      <Badge class="border border-primary/40 bg-transparent text-primary uppercase tracking-wider">
        Бесплатно · OpenRouter
      </Badge>
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Настройки</h1>
      <p class="max-w-2xl text-muted-foreground">
        Платформа только для тебя. Прогресс и ключ живут в браузере — без подписок и без бэкенда.
        Подключи наставника один раз и возвращайся к прокачке.
      </p>
    </div>

    <Card class="border-border bg-card/80">
      <CardHeader>
        <CardTitle>AI-наставник (OpenRouter)</CardTitle>
        <CardDescription>
          Ключ берёшь на{" "}
          <a
            class="text-primary underline underline-offset-4"
            href="https://openrouter.ai/keys"
            target="_blank"
            rel="noreferrer"
          >
            openrouter.ai/keys
          </a>
          . Для модулей — модели с суффиксом{" "}
          <code class="rounded bg-muted px-1 py-0.5 text-xs text-accent">:free</code>.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <ApiKeyForm client:load />
      </CardContent>
    </Card>

    <Card class="border-border bg-card/80">
      <CardHeader>
        <CardTitle>Где живёт сайт</CardTitle>
        <CardDescription>
          Репозиторий{" "}
          <a
            class="text-primary underline underline-offset-4"
            href="https://github.com/minovs205-cyber/school_smart_analyst"
            target="_blank"
            rel="noreferrer"
          >
            minovs205-cyber/school_smart_analyst
          </a>
          . После push на{" "}
          <code class="rounded bg-muted px-1 py-0.5 text-xs">main</code> GitHub Actions собирает
          Pages. Адрес:{" "}
          <code class="rounded bg-muted px-1 py-0.5 text-xs">
            https://minovs205-cyber.github.io/school_smart_analyst/
          </code>
        </CardDescription>
      </CardHeader>
    </Card>
  </div>
</BaseLayout>
