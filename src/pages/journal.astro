---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';

const settingsHref = `${import.meta.env.BASE_URL}settings`;
---

<BaseLayout title="Журнал" description="Еженедельная рефлексия и поиск паттернов.">
  <ModuleStub
    client:load
    title="Рефлексия и извлечение уроков"
    step="Шаг 7 · скоро"
    description="Прокачка без рефлексии — бег на месте. Раз в неделю фиксируй: что узнал, где ошибся, где ИИ помог, а где подставил. AI найдёт паттерны слабых мест."
    bullets={[
      'Форма еженедельного журнала',
      'Записи в localStorage',
      'AI-анализ паттернов через OpenRouter',
      'Визуализация прогресса во времени',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
