---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';

const settingsHref = `${import.meta.env.BASE_URL}settings`;
---

<BaseLayout title="Кейсы" description="Сложные рабочие кейсы и AI-наставник.">
  <ModuleStub
    client:load
    title="Сложные кейсы"
    step="Шаг 3 · скоро"
    description="Не учебные «напиши user story». Реальные ситуации с работы — анонимно, по делу. AI-наставник будет давить неудобными вопросами, пока ты не разберёшь корень проблемы."
    bullets={[
      'Библиотека кейсов в Markdown',
      'Фильтры: тип, сложность, домен',
      'AI-наставник через OpenRouter',
      'Личные заметки по кейсу в браузере',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
