---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { AiMentor } from '@/components/mentor/AiMentor';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { CASES, getCaseBySlug } from '@/data/cases';
import { withBase } from '@/lib/paths';

export function getStaticPaths() {
  return CASES.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const item = getCaseBySlug(slug ?? '');
if (!item) {
  throw new Error(`Кейс не найден: ${slug}`);
}

const base = import.meta.env.BASE_URL;
const settingsHref = withBase(base, '/settings');
const caseContext = `${item.situation}\n\nНапряжение:\n${item.tension}\n\nТвоя роль:\n${item.yourRole}`;
---

<BaseLayout title={item.title} description={item.summary}>
  <div class="space-y-6">
    <div class="space-y-3">
      <a href={withBase(base, '/cases')} class="text-sm text-primary hover:underline">← Все кейсы</a>
      <div class="flex flex-wrap gap-2">
        <Badge class="border-0 bg-accent/20 text-accent">{item.difficulty}</Badge>
        <Badge variant="secondary">{item.domain}</Badge>
        {item.tags.map((t) => <Badge variant="outline">{t}</Badge>)}
      </div>
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{item.title}</h1>
      <p class="max-w-3xl text-muted-foreground">{item.summary}</p>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <Card class="border-border bg-card/80">
        <CardHeader>
          <CardTitle>Ситуация</CardTitle>
        </CardHeader>
        <CardContent>
          <p class="whitespace-pre-wrap text-sm leading-relaxed text-muted-foreground">{item.situation}</p>
        </CardContent>
      </Card>
      <Card class="border-border bg-card/80">
        <CardHeader>
          <CardTitle>Напряжение и твоя роль</CardTitle>
        </CardHeader>
        <CardContent class="space-y-4 text-sm leading-relaxed text-muted-foreground">
          <p class="whitespace-pre-wrap">{item.tension}</p>
          <p class="whitespace-pre-wrap text-foreground">{item.yourRole}</p>
        </CardContent>
      </Card>
    </div>

    <AiMentor
      client:load
      caseTitle={item.title}
      caseContext={caseContext}
      settingsHref={settingsHref}
    />
  </div>
</BaseLayout>
