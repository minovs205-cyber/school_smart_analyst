---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';

const settingsHref = `${import.meta.env.BASE_URL}settings`;
---

<BaseLayout title="Переговоры" description="Симуляции переговоров со стейкхолдерами.">
  <ModuleStub
    client:load
    title="Переговоры и soft skills"
    step="Шаг 6 · скоро"
    description="Сложный стейкхолдер не читает твой Confluence. Здесь ты тренируешь диалог: ИИ играет роль оппонента с характером и позицией. Цель — win-win, не «согласовали молчанием»."
    bullets={[
      'Чат-симуляция со стейкхолдером',
      'Разбор конфликтов и поиск win-win',
      'Шаблоны рефлексии после разговора',
      'История диалога сохраняется локально',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
