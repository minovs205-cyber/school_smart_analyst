---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';
import { withBase } from '@/lib/paths';

const settingsHref = withBase(import.meta.env.BASE_URL, '/settings');
---

<BaseLayout title="Переговоры" description="Симуляции переговоров со стейкхолдерами.">
  <ModuleStub
    client:load
    title="Переговоры"
    step="Программа · уровень 5"
    description="Уровень L5: спонсор, комплаенс, ИБ за одним столом. Пока спарринг — через ИИ-наставника в кейсах; отдельный чат оппонента подключим."
    bullets={[
      'Спарринг с CISO / спонсором (квест L5-Q1)',
      'Повестка фасилитации на 45 минут',
      'Конфликт интересов → взаимовыгодный объём',
      'История диалога локально',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
