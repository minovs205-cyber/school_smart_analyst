---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';
import { withBase } from '@/lib/paths';

const settingsHref = withBase(import.meta.env.BASE_URL, '/settings');
---

<BaseLayout title="Переговоры" description="Симуляции переговоров со стейкхолдерами.">
  <ModuleStub
    client:load
    title="Переговоры"
    step="Позже · в очереди"
    description="Симуляция оппонента (CISO, спонсор, владелец продукта) будет отдельным чатом. Сейчас тренируй жёсткие вопросы через ИИ-наставника в кейсах."
    bullets={[
      'Чат со стейкхолдером с характером',
      'Разбор конфликтов и win-win',
      'Шаблоны рефлексии',
      'История диалога локально',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
