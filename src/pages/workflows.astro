---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';
import { withBase } from '@/lib/paths';

const settingsHref = withBase(import.meta.env.BASE_URL, '/settings');
---

<BaseLayout title="Сценарии с ИИ" description="Тренажёр работы аналитика с ИИ.">
  <ModuleStub
    client:load
    title="Сценарии с ИИ"
    step="Позже · в очереди"
    description="Сначала закрой путь «карта → кейс → журнал». Этот модуль — промпты аналитика, поиск ошибок в генерации и сравнение решений — подключим следующим."
    bullets={[
      'Шаблоны промптов для SA',
      'Тренажёр: твой промпт → ответ модели → оценка',
      'Кейсы «найди ошибки в генерации»',
      'Сравнение: ты vs ИИ vs эталон',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
