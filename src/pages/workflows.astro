---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';
import { withBase } from '@/lib/paths';

const settingsHref = withBase(import.meta.env.BASE_URL, '/settings');
---

<BaseLayout title="Сценарии с ИИ" description="Тренажёр работы аналитика с ИИ.">
  <ModuleStub
    client:load
    title="Сценарии с ИИ"
    step="Модуль 2 · критика генерации"
    description="Модуль профессионального роста: постановка задач модели и валидация выводов. Практики описаны в Программе; интерактивный тренажёр подключим следующим."
    bullets={[
      'Шаблоны промптов для системного аналитика',
      'Тренажёр: промпт → ответ → оценка дыр',
      'Ревью историй от модели с ИИ-наставником',
      'Сравнение: вы vs ИИ vs эталон',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
