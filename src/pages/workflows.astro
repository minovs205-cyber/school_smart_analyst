---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';

const settingsHref = `${import.meta.env.BASE_URL}settings`;
---

<BaseLayout title="Workflows" description="Тренажёр работы аналитика с ИИ.">
  <ModuleStub
    client:load
    title="AI-Augmented Workflows"
    step="Шаг 4 · скоро"
    description="ИИ — твой джун, не замена. Здесь ты учишься ставить задачи так, чтобы результат был полезен: находишь ошибки в сгенерированных требованиях и сравниваешь решения."
    bullets={[
      'Промпты для аналитика — готовые шаблоны',
      'Тренажёр: твой промпт → ответ ИИ → твоя оценка',
      'Кейсы «найди 5 ошибок в генерации»',
      'Сравнение: ты vs ИИ vs эталон',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
