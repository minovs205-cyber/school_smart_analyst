---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';
import { withBase } from '@/lib/paths';

const settingsHref = withBase(import.meta.env.BASE_URL, '/settings');
---

<BaseLayout title="Сценарии с ИИ" description="Тренажёр работы аналитика с ИИ.">
  <ModuleStub
    client:load
    title="Сценарии с ИИ"
    step="Программа · уровень 2"
    description="Модуль программы school_smart_analyst: постановка задач модели и критика генерации. Пока каркас — квесты L2 уже описаны в Программе; контент тренажёра подключим следующим."
    bullets={[
      'Шаблоны промптов для системного аналитика',
      'Тренажёр: промпт → ответ → оценка дыр',
      'Квест L2: дыры в «готовых» историях с наставником',
      'Сравнение: ты vs ИИ vs эталон',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
