---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';
import { withBase } from '@/lib/paths';

const settingsHref = withBase(import.meta.env.BASE_URL, '/settings');
---

<BaseLayout title="Домен" description="Глубокая доменная экспертиза banking / fintech.">
  <ModuleStub
    client:load
    title="Домен банка"
    step="Программа · уровень 3"
    description="Уровень L3 программы: платежи, онбординг, 115-ФЗ — где модель врёт уверенно. Пока качай кейсы; библиотека материалов — следующим этапом."
    bullets={[
      'Конспект платёжного пути (квест L3-Q1)',
      'Кейс чат-бот + 115-ФЗ с ИИ-наставником',
      '115-ФЗ, PCI DSS, требования ЦБ',
      'Контент в Markdown',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
