---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';
import { withBase } from '@/lib/paths';

const settingsHref = withBase(import.meta.env.BASE_URL, '/settings');
---

<BaseLayout title="Домен" description="Глубокая доменная экспертиза banking / fintech.">
  <ModuleStub
    client:load
    title="Доменная экспертиза"
    step="Позже · в очереди"
    description="Пока домен качается через кейсы (115-ФЗ, legacy-платежи). Отдельная библиотека материалов по ЦБ и PCI — следующим этапом."
    bullets={[
      'Материалы по 115-ФЗ, PCI DSS, требованиям ЦБ',
      'Интеграции с legacy',
      'Поиск по темам',
      'Контент в Markdown',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
