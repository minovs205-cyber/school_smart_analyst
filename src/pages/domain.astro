---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';
import { withBase } from '@/lib/paths';

const settingsHref = withBase(import.meta.env.BASE_URL, '/settings');
---

<BaseLayout title="Домен" description="Глубокая доменная экспертиза banking / fintech.">
  <ModuleStub
    client:load
    title="Домен банка"
    step="Модуль 3 · домен без Wiki"
    description="Платежи, онбординг, 115-ФЗ — где модель звучит уверенно, но ошибается. Пока опора на кейсы; библиотека материалов — следующим этапом."
    bullets={[
      'Конспект платёжного пути',
      'Кейс чат-бот + 115-ФЗ с ИИ-наставником',
      '115-ФЗ, PCI DSS, требования ЦБ',
      'Контент в Markdown',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
