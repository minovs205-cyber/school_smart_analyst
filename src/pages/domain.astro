---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ModuleStub } from '@/components/ModuleStub';

const settingsHref = `${import.meta.env.BASE_URL}settings`;
---

<BaseLayout title="Домен" description="Глубокая доменная экспертиза banking / fintech.">
  <ModuleStub
    client:load
    title="Доменная экспертиза"
    step="Шаг 5 · скоро"
    description="ИИ перескажет PCI DSS за минуту. Ты должен понимать, почему легаси-шлюз в банке ломает красивую схему на проде. Здесь — глубина, а не поверхностный пересказ."
    bullets={[
      'Кейсы по 115-ФЗ, PCI DSS, требованиям ЦБ',
      'Интеграции с legacy-системами',
      'Поиск и фильтры по темам регуляторики',
      'Контент в Markdown — правишь сам, без кода',
    ]}
    settingsHref={settingsHref}
  />
</BaseLayout>
