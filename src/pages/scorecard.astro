---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { AIDiagnosticWizard } from '@/components/diagnostic/AIDiagnosticWizard';

const base = import.meta.env.BASE_URL;
const autoStart = Astro.url.searchParams.get('start') === '1';
---

<BaseLayout
  title="AI-диагностика"
  description="Ситуационная AI-диагностика компетенций системного аналитика: неопределённость, валидация генерации, стейкхолдеры."
>
  <AIDiagnosticWizard client:load baseUrl={base} autoStart={autoStart} />
</BaseLayout>
