---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';

const base = import.meta.env.BASE_URL;

const modules = [
  {
    href: `${base}scorecard`,
    tag: 'Модуль 1',
    title: 'AI-Resistance Scorecard',
    text: 'Оцени навыки по шкале «насколько ИИ это заменит» и узнай, что качать первым.',
  },
  {
    href: `${base}cases`,
    tag: 'Модуль 2',
    title: 'Сложные кейсы',
    text: 'Реальные ситуации с работы. AI-наставник задаёт неудобные вопросы — без воды.',
  },
  {
    href: `${base}workflows`,
    tag: 'Модуль 3',
    title: 'AI-Augmented Workflows',
    text: 'Учись ставить задачи ИИ правильно: находи ошибки в генерации и улучшай результат.',
  },
  {
    href: `${base}domain`,
    tag: 'Модуль 4',
    title: 'Доменная экспертиза',
    text: '115-ФЗ, PCI DSS, ЦБ, legacy. То, что ИИ знает поверхностно — а ты должен глубоко.',
  },
  {
    href: `${base}soft-skills`,
    tag: 'Модуль 5',
    title: 'Переговоры и soft skills',
    text: 'Симуляции со сложными стейкхолдерами. Ищи win-win, а не «согласовали как есть».',
  },
  {
    href: `${base}journal`,
    tag: 'Модуль 6',
    title: 'Рефлексия',
    text: 'Еженедельный журнал: что узнал, где ошибся, как ИИ мог помочь — и где мешал.',
  },
];
---

<BaseLayout title="Главная">
  <section class="relative space-y-10">
    <div class="space-y-5">
      <div class="flex flex-wrap gap-2">
        <Badge class="border border-primary/40 bg-transparent text-primary uppercase tracking-wider">
          Системный анализ
        </Badge>
        <Badge class="border border-accent/50 bg-transparent text-accent uppercase tracking-wider">
          Устойчивость к ИИ
        </Badge>
        <Badge variant="secondary" class="uppercase tracking-wider">Банкинг · $0</Badge>
      </div>

      <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight md:text-5xl">
        Здесь ты прокачаешь аналитика,<br class="hidden sm:block" />
        <span class="text-primary">которого ИИ не заменит</span>
      </h1>

      <p class="max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg">
        Не важно, сколько лет в банке и насколько ИИ уже пишет user stories. Системный анализ — это
        навык: переговоры, неопределённость, архитектура и домен. Считай эту платформу своим
        тренажёром антихрупкости. Тренируйся в своём темпе. Кодить ТЗ за тебя ИИ может — думать за
        стейкхолдеров нет. Просто начни.
      </p>

      <div class="flex flex-wrap gap-3">
        <Button asChild size="lg" class="font-bold uppercase tracking-wide">
          <a href={`${base}scorecard`}>Я в деле — начнём!</a>
        </Button>
        <Button
          asChild
          size="lg"
          variant="outline"
          class="border-primary font-semibold text-primary hover:bg-primary hover:text-primary-foreground"
        >
          <a href={`${base}settings`}>Подключить AI-наставника</a>
        </Button>
      </div>
    </div>

    <div class="space-y-4">
      <h2 class="text-xl font-semibold tracking-tight md:text-2xl">
        Что тебя ждёт на платформе
      </h2>
      <p class="max-w-2xl text-sm text-muted-foreground md:text-base">
        Шесть модулей под навыки, которые сложно автоматизировать. Без рутины, которую ИИ уже делает
        лучше.
      </p>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          modules.map((mod) => (
            <a href={mod.href} class="group block">
              <Card class="h-full border-border bg-card/80 transition-colors group-hover:border-primary/60">
                <CardHeader class="space-y-2">
                  <Badge class="w-fit border-0 bg-accent/20 text-accent">{mod.tag}</Badge>
                  <CardTitle class="text-base group-hover:text-primary">{mod.title}</CardTitle>
                  <CardDescription class="text-muted-foreground">{mod.text}</CardDescription>
                </CardHeader>
                <CardContent>
                  <span class="text-sm font-semibold text-primary">Перейти →</span>
                </CardContent>
              </Card>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
