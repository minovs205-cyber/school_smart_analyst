---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GrowthModulesAccordion } from '@/components/home/GrowthModulesAccordion';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { PLATFORM } from '@/data/curriculum';
import { withBase } from '@/lib/paths';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Главная" description={PLATFORM.goal}>
  <section class="space-y-12">
    <div class="space-y-5">
      <div class="flex flex-wrap gap-2">
        <Badge class="border border-primary/40 bg-transparent text-primary uppercase tracking-wider">
          school_smart_analyst
        </Badge>
        <Badge class="border border-accent/50 bg-transparent text-accent uppercase tracking-wider">
          Middle+ / Senior
        </Badge>
      </div>

      <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight md:text-5xl">
        Антихрупкий системный аналитик
      </h1>

      <p class="max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg">
        Превратите генеративный ИИ в своего младшего помощника. Практическая платформа для аналитиков,
        которые хотят делегировать рутину, работать с неопределённостью и фокусироваться на
        архитектуре, а не на шаблонных ТЗ.
      </p>

      <div class="flex flex-wrap gap-2">
        <Button asChild size="lg" class="h-11 px-5 font-semibold">
          <a href={withBase(base, '/scorecard')}>Начать AI-диагностику</a>
        </Button>
        <Button asChild size="lg" variant="outline" class="h-11 border-border px-5">
          <a href={withBase(base, '/program')}>Изучить модули программы</a>
        </Button>
      </div>
    </div>

    <div class="space-y-4">
      <h2 class="text-xl font-semibold tracking-tight md:text-2xl">С чего начать</h2>
      <div class="grid gap-4 md:grid-cols-3">
        <Card class="border-primary/40 bg-card/80">
          <CardHeader>
            <Badge class="w-fit bg-primary text-primary-foreground">1</Badge>
            <CardTitle class="text-base">AI-диагностика</CardTitle>
            <CardDescription>
              5 минут, ситуационные вопросы, первичная оценка компетенций.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <Button asChild class="font-semibold">
              <a href={withBase(base, '/scorecard')}>Пройти AI-диагностику (5 мин)</a>
            </Button>
          </CardContent>
        </Card>

        <Card class="border-border bg-card/80">
          <CardHeader>
            <Badge class="w-fit border-0 bg-accent/20 text-accent">2</Badge>
            <CardTitle class="text-base">Кейс с ИИ-наставником</CardTitle>
            <CardDescription>
              Разбор реальной ситуации банка. Наставник уточняет — решение ваше.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <Button asChild variant="outline" class="border-primary font-semibold text-primary">
              <a href={withBase(base, '/cases')}>Разобрать реальный кейс с ИИ</a>
            </Button>
          </CardContent>
        </Card>

        <Card class="border-border bg-card/80">
          <CardHeader>
            <Badge variant="secondary" class="w-fit">3</Badge>
            <CardTitle class="text-base">Журнал инсайтов</CardTitle>
            <CardDescription>
              Фиксация решений и роли ИИ в работе — привычка антихрупкого инженера.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <Button asChild variant="outline">
              <a href={withBase(base, '/journal')}>Зафиксировать инсайт недели</a>
            </Button>
          </CardContent>
        </Card>
      </div>
    </div>

    <GrowthModulesAccordion client:load baseUrl={base} />

    <p class="max-w-2xl text-sm text-muted-foreground">
      Нужен разбор 1:1 по карьере или кейсу?
      <a class="ml-1 text-primary underline-offset-4 hover:underline" href={withBase(base, '/consultations')}>
        Консультации
      </a>
    </p>
  </section>
</BaseLayout>
