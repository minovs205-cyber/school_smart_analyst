---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { withBase } from '@/lib/paths';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Главная">
  <section class="space-y-10">
    <div class="space-y-5">
      <div class="flex flex-wrap gap-2">
        <Badge class="border border-primary/40 bg-transparent text-primary uppercase tracking-wider">
          Личный тренажёр
        </Badge>
        <Badge class="border border-accent/50 bg-transparent text-accent uppercase tracking-wider">
          Системный аналитик в банке
        </Badge>
      </div>

      <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight md:text-5xl">
        Прокачай то, что <span class="text-primary">ИИ не заменит</span>
      </h1>

      <p class="max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg">
        Не шесть «курсов ради курсов» — один путь на сегодня: оцени навыки, разбери кейс с наставником,
        зафиксируй урок недели. Остальное — по мере привычки.
      </p>
    </div>

    <div class="space-y-4">
      <h2 class="text-xl font-semibold tracking-tight md:text-2xl">Путь на сегодня</h2>
      <div class="grid gap-4 md:grid-cols-3">
        <Card class="border-primary/40 bg-card/80">
          <CardHeader>
            <Badge class="w-fit bg-primary text-primary-foreground">Шаг 1</Badge>
            <CardTitle class="text-base">Карта навыков</CardTitle>
            <CardDescription>
              12 банковских SA-навыков, радар и топ-3 «что качать». Без ИИ — быстро и честно.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <Button asChild class="font-semibold">
              <a href={withBase(base, '/scorecard')}>Открыть карту</a>
            </Button>
          </CardContent>
        </Card>

        <Card class="border-border bg-card/80">
          <CardHeader>
            <Badge class="w-fit border-0 bg-accent/20 text-accent">Шаг 2</Badge>
            <CardTitle class="text-base">Кейс + ИИ-наставник</CardTitle>
            <CardDescription>
              Реальная ситуация из банка. Наставник задаёт неудобные вопросы через OpenRouter.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <Button asChild variant="outline" class="border-primary font-semibold text-primary">
              <a href={withBase(base, '/cases')}>К кейсам</a>
            </Button>
          </CardContent>
        </Card>

        <Card class="border-border bg-card/80">
          <CardHeader>
            <Badge variant="secondary" class="w-fit">Шаг 3</Badge>
            <CardTitle class="text-base">Журнал недели</CardTitle>
            <CardDescription>
              Три поля: что узнал, где ошибся, роль ИИ. Привычка важнее идеального текста.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <Button asChild variant="outline">
              <a href={withBase(base, '/journal')}>Записать неделю</a>
            </Button>
          </CardContent>
        </Card>
      </div>
    </div>

    <div class="space-y-3">
      <h2 class="text-lg font-semibold">Позже — когда путь войдёт в привычку</h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <a class="rounded-full border border-border px-3 py-1 text-muted-foreground hover:border-primary hover:text-primary" href={withBase(base, '/workflows')}>
          Сценарии с ИИ
        </a>
        <a class="rounded-full border border-border px-3 py-1 text-muted-foreground hover:border-primary hover:text-primary" href={withBase(base, '/domain')}>
          Домен
        </a>
        <a class="rounded-full border border-border px-3 py-1 text-muted-foreground hover:border-primary hover:text-primary" href={withBase(base, '/soft-skills')}>
          Переговоры
        </a>
        <a class="rounded-full border border-border px-3 py-1 text-muted-foreground hover:border-primary hover:text-primary" href={withBase(base, '/settings')}>
          Настройки ключа
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
