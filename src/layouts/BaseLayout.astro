---
import '@/styles/global.css';
import { AppShell, type NavItem } from '@/components/layout/AppShell';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import { absoluteUrl, BRAND_RU, SITE_NAME } from '@/lib/site';
import { withBase } from '@/lib/paths';

interface Props {
  title: string;
  description?: string;
  /** Open Graph type */
  ogType?: 'website' | 'article';
  /** noindex for settings etc. */
  noindex?: boolean;
}

const {
  title,
  description = 'Инженерная платформа для системных аналитиков: антихрупкость, делегирование рутины ИИ, фокус на архитектуре. school_smart_analyst.',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const pageTitle = `${title} · ${BRAND_RU}`;
const ogImage = absoluteUrl(baseUrl, '/favicon.svg');

const navItems: NavItem[] = [
  { href: '/', label: 'Главная' },
  { href: '/program', label: 'Программа' },
  { href: '/scorecard', label: 'Диагностика' },
  { href: '/cases', label: 'Кейсы' },
  { href: '/journal', label: 'Журнал' },
  { href: '/consultations', label: 'Консультации' },
  { href: '/settings', label: 'Настройки' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: BRAND_RU,
  alternateName: SITE_NAME,
  url: absoluteUrl(baseUrl, '/'),
  description,
  inLanguage: 'ru-RU',
};
---

<!doctype html>
<html lang="ru" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase(baseUrl, '/favicon.svg')} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={BRAND_RU} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <AppShell client:load baseUrl={baseUrl} currentPath={currentPath} items={navItems} />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 md:py-12">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
