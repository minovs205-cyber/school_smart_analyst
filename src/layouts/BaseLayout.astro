---
import '@/styles/global.css';
import { AppShell, type NavItem } from '@/components/layout/AppShell';
import { withBase } from '@/lib/paths';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Персональная платформа: прокачай навыки системного аналитика, которые ИИ не заменит.',
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const navItems: NavItem[] = [
  { href: '/', label: 'Главная' },
  { href: '/scorecard', label: 'Scorecard' },
  { href: '/cases', label: 'Кейсы' },
  { href: '/workflows', label: 'Workflows' },
  { href: '/domain', label: 'Домен' },
  { href: '/soft-skills', label: 'Переговоры' },
  { href: '/journal', label: 'Журнал' },
  { href: '/settings', label: 'Настройки' },
];
---

<!doctype html>
<html lang="ru" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase(baseUrl, '/favicon.svg')} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <title>{title} · AI-Resistance Analyst</title>
  </head>
  <body class="min-h-screen">
    <AppShell client:load baseUrl={baseUrl} currentPath={currentPath} items={navItems} />
    <main class="mx-auto max-w-6xl px-4 py-8 md:py-12">
      <slot />
    </main>
  </body>
</html>
